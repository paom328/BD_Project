    <config key="model">
        <entry key="python3_command" type="xstring" value=""/>
        <entry key="script" type="xstring" value="import knime.scripting.io as knio%%00010import pandas as pd%%00010from statsmodels.tsa.api import Holt%%00010%%00010# 1. Read the complete unpivoted dataset from KNIME%%00010df_all = knio.input_tables[0].to_pandas()%%00010%%00010forecast_list = []%%00010horizon = 7  # Forecast years (2024–2030)%%00010%%00010# 2. Iterate through each municipality group in Python%%00010for municipality, df_group in df_all.groupby('ColumnNames'):%%00010    # Ensure chronological order%%00010    df_sorted = df_group.sort_values('año')%%00010    values = df_sorted['ColumnValues'].astype(float).values%%00010    %%00010    # Fit Holt's Linear Trend model%%00010    model = Holt(values, initialization_method=&quot;estimated&quot;).fit()%%00010    %%00010    # Forecast future values%%00010    forecast_values = model.forecast(horizon)%%00010    %%00010    # Construct future year range%%00010    last_year = int(df_sorted['año'].max())%%00010    future_years = list(range(last_year + 1, last_year + 1 + horizon))%%00010    %%00010    # Create temporary DataFrame for this municipality%%00010    df_forecast = pd.DataFrame({%%00010        'año': future_years,%%00010        'ColumnNames': municipality,%%00010        'Forecast_Holt': forecast_values%%00010    })%%00010    %%00010    forecast_list.append(df_forecast)%%00010%%00010# 3. Concatenate all municipal forecasts into a single table%%00010output_df = pd.concat(forecast_list, ignore_index=True)%%00010%%00010# 4. Output the combined table back to KNIME%%00010knio.output_tables[0] = knio.Table.from_pandas(output_df)"/>
