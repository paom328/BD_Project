    <config key="model">
        <entry key="python3_command" type="xstring" value=""/>
        <entry key="script" type="xstring" value="import knime.scripting.io as knio%%00010import pandas as pd%%00010from prophet import Prophet%%00010%%00010# 1. Read full unpivoted dataset%%00010df_all = knio.input_tables[0].to_pandas()%%00010%%00010forecast_list = []%%00010%%00010# 2. Iterate over each municipality directly in Python%%00010for municipality, df_group in df_all.groupby('ColumnNames'):%%00010    # Prepare individual series%%00010    df_prophet = pd.DataFrame({%%00010        'ds': pd.to_datetime(df_group['año'].astype(str) + '-01-01'),%%00010        'y': df_group['ColumnValues'].astype(float)%%00010    })%%00010    %%00010    # Initialize and fit Prophet%%00010    model = Prophet(%%00010        yearly_seasonality=False,%%00010        weekly_seasonality=False,%%00010        daily_seasonality=False,%%00010        growth='linear'%%00010    )%%00010    model.fit(df_prophet)%%00010    %%00010    # Forecast 7 years ahead (2024-2030)%%00010    future = model.make_future_dataframe(periods=7, freq='YS')%%00010    forecast = model.predict(future)%%00010    %%00010    # Get future 7 years%%00010    future_forecast = forecast.tail(7).copy()%%00010    future_forecast['año'] = future_forecast['ds'].dt.year%%00010    future_forecast['ColumnNames'] = municipality%%00010    future_forecast['Forecast_Prophet'] = future_forecast['yhat']%%00010    %%00010    forecast_list.append(future_forecast[['año', 'ColumnNames', 'Forecast_Prophet']])%%00010%%00010# 3. Combine all forecasts into one single table%%00010output_df = pd.concat(forecast_list, ignore_index=True)%%00010%%00010# 4. Output to KNIME%%00010knio.output_tables[0] = knio.Table.from_pandas(output_df)"/>
