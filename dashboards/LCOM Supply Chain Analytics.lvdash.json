{
  "datasets": [
    {
      "name": "supply_chain_metrics",
      "displayName": "Supply Chain Metrics (Silver)",
      "queryLines": [
        "SELECT\n",
        "  cod_pus,\n",
        "  DEPARTAMENTO,\n",
        "  MUNICIPIO,\n",
        "  TIPOLOGIA_ROLLOS,\n",
        "  T AS status,\n",
        "  SEDE_OPERACIONES,\n",
        "  riesgo_desabastecimiento,\n",
        "  `ACCIÓN` AS accion,\n",
        "  saldo_dias_ajustado,\n",
        "  saldo_rollos_ajustado,\n",
        "  tasa_consumo_diario,\n",
        "  requiere_reabastecimiento,\n",
        "  `ROLLOS_CONSUMIDOS_DESDE_MIGRACIÓN_O_APERTURA` AS rollos_consumidos,\n",
        "  `ROLLOS_ENTREGADOS_DESDE_MIGRACIÓN_O_APERTURA` AS rollos_entregados,\n",
        "  TRY_TO_DATE(SUBSTR(`FECHA_MIGRACIÓN_O_APERTURA`, 1, 10)) AS migration_date,\n",
        "  CASE\n",
        "    WHEN T = 'DESABASTECIDO' THEN 1\n",
        "    ELSE 0\n",
        "  END AS is_stockout,\n",
        "  CASE\n",
        "    WHEN `ACCIÓN` = 'REABASTECER' THEN 1\n",
        "    ELSE 0\n",
        "  END AS is_reabastecer\n",
        "FROM\n",
        "  catalog_lcom.silver.supply_chain_master"
      ]
    }
  ],
